{
  "name": "nganya-surfers-monorepo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@nganya-surfers/game",
    "dev:game": "npm run dev --workspace=@nganya-surfers/game",
    "dev:admin": "npm run dev --workspace=@nganya-surfers/admin",
    "build:game": "npm run build --workspace=@nganya-surfers/game",
    "build:admin": "npm run build --workspace=@nganya-surfers/admin",
    "build": "npm run build:game && npm run build:admin",
    "deploy:game": "npm run build:game && cd apps/game && npx wrangler pages deploy dist --project-name=nganyarunner"
  },
  "devDependencies": {
    "typescript": "^5.7.3",
    "vite": "^6.2.0",
    "wrangler": "^4.160.0"
  }
}
